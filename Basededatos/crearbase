//Creo la tabla jugadores

CREATE TABLE jugadores (
    nombre VARCHAR(100),
    apellidos VARCHAR(100),
    fecha_de_nacimiento VARCHAR(100),
    posicion VARCHAR(100),
    dorsal INT
);
SHOW TABLES;
DESCRIBE jugadores;

